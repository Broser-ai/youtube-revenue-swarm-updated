# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: YouTube Data API v3 key (server-side only). Enables live /api/swarm/youtube/search.
YOUTUBE_API_KEY=""

# Optional: TikTok for Developers (status only until an official publish flow is configured).
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Optional: Meta Graph API (status only — dispatcher formats Reels copy, it does not publish).
META_ACCESS_TOKEN=""

# Optional: X API v2 bearer token (status only — dispatcher formats threads, it does not publish).
X_BEARER_TOKEN=""

# Optional: OpenAI key for future model routing. Gemini remains the default generator.
OPENAI_API_KEY=""

# Bind address uses 0.0.0.0 and PORT (defaults to 3000).
PORT=3000
